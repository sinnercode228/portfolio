# ── Обязательно ────────────────────────────────────────────────────────────────
# Токен бота от @BotFather
BOT_TOKEN=123456789:replace-me-with-token-from-botfather

# ── Администраторы ─────────────────────────────────────────────────────────────
# Telegram ID админов через запятую: им доступны /leads, /export, /stats, /broadcast
# и кнопки статусов заявок. Свой ID можно узнать, отправив боту команду /id.
ADMIN_IDS=

# Куда присылать уведомления о новых заявках: ID пользователей и/или групп через запятую.
# Пусто = в личку каждому из ADMIN_IDS. ID группы начинается с -100… (отправьте /id в группе).
ADMIN_CHAT_IDS=

# ── Необязательно ──────────────────────────────────────────────────────────────
# Путь к файлу SQLite (папка создаётся автоматически)
DB_PATH=data/leads.db

# Часовой пояс для дат в уведомлениях, /leads, /stats и CSV
TIMEZONE=Europe/Moscow

# Антиспам: сколько минут пользователь ждёт перед следующей заявкой (0 — без ограничений)
LEAD_COOLDOWN_MINUTES=5

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Дублировать логи в файл с ротацией (пусто — только stdout).
# В Docker и systemd логи уже собираются (docker compose logs / journalctl), поле можно не заполнять;
# если нужно — указывайте путь внутри data/, например data/bot.log: писать можно только туда.
LOG_FILE=
